# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for common source files
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Do not normalize binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dta binary
*.whl binary
